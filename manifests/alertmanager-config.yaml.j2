apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-monitoring-kube-prometheus-alertmanager
  namespace: monitoring
type: Opaque
stringData:
  alertmanager.yaml: |
    global:
      resolve_timeout: 5m
      smtp_smarthost: 'smtp.gmail.com:587'
      smtp_from: {{ alertmanager_smtp_from | to_json }}
      smtp_auth_username: {{ alertmanager_smtp_username | to_json }}
      smtp_auth_password: {{ alertmanager_smtp_password | to_json }}
      smtp_require_tls: true

    route:
      receiver: "email"
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1h
      routes:
        - matchers:
            - alertname="Watchdog"
          receiver: "null"
        - matchers:
            - severity="critical"
          receiver: "email"

    receivers:
      - name: "null"
      - name: "email"
        email_configs:
          - to: {{ alertmanager_smtp_to | to_json }}
